# Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:npg_sample_pass@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=change_me_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email Service (Optional: leave blank for Ethereal test mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="TaskFlow" <noreply@taskflow.app>

# App Public URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
